# ===== 构建产物与缓存 =====
/build/
/entry/build/
/dist/
/.hvigor/
*.hap

# ===== 随包的 SDK/工具链副本（构建使用 local.properties 指向的本机 SDK） =====
/llvm/
/build-tools/
/common/
/sysroot/
/api/
/arkts/
/component/
/configcheck/
/form/
/kits/
/lib/
/liteWearable/
/modulecheck/
/rescheck/
/syscapcheck/
/resources/
/*.exe
/*.dll
/NOTICE.txt
/id_defined.json
/nativeapi_syscap_config.json
/ndk_system_capability.json
/compatible_config.json
/restool_faq.json
/oh-uni-package.json
/sdk-pkg.json

# ===== 签名凭据与证书材料（绝不入库） =====
/tmpca/
/*.jks
/*.p12
/*.pem
/*.key
/*.cer
/*.csr
/*.p7b
/xjit-debug-profile.json

# ===== 机器本地配置与环境变量（密钥不入库） =====
/local.properties
/.idea/
/.freebuff/
/.claude/settings.local.json
*.bak-*
/.env
**/.env
!**/.env.example
/material/

# ===== 证据/快照/备份（体积大，历史记录留在磁盘） =====
/docs/html/
/.preview/
/.ui-backups/
/.wolf/*
!/.wolf/memory.md
!/.wolf/*.json
/*.jpeg

# ===== 通用依赖与本地日志 =====
node_modules/
oh_modules/
*.log
.env.*
!.env.example
